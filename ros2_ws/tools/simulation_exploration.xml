<launch>
  <!-- Drone Simulator (replaces real drone) -->
  <node pkg="localization" exec="drone_simulator" name="drone_simulator"/>
  
  <!-- SLAM and autonomous exploration -->
  <node pkg="localization" exec="slam_mapper" name="slam_mapper"/>
  <node pkg="localization" exec="autonomous_explorer" name="autonomous_explorer"/>
  <node pkg="localization" exec="compass_mapping" name="compass_mapping"/>
  <node pkg="localization" exec="rviz_visualizer" name="rviz_visualizer"/>
  <node pkg="localization" exec="map_saver" name="map_saver"/>
  
  <!-- RViz Visualization -->
  <executable cmd="rviz2" args="-d $(find-pkg-share localization)/config/drone_visualization.rviz" name="rviz2"/>
</launch>
