<launch>
  <!-- Core drone functionality -->
  <node pkg="my_drone" exec="drone_driver" name="drone_driver"/>
  
  <!-- AI and detection -->
  <node pkg="ai" exec="person_detection" name="person_detection"/>
  
  <!-- SLAM and navigation -->
  <node pkg="localization" exec="slam_mapper" name="slam_mapper"/>
  <node pkg="localization" exec="mission_coordinator" name="mission_coordinator"/>
  <node pkg="localization" exec="compass_mapping" name="compass_mapping"/>
  
  <!-- Visualization -->
  <node pkg="my_drone" exec="visualization" name="visualization"/>
  <node pkg="visualization" exec="rviz_setup" name="rviz_setup"/>
  <node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(find-pkg-share visualization)/config/tello.rviz"/>
</launch>
