            <box>
              <size>0.1 4 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      
      <!-- East wall (partial - door to hallway) -->
      <link name="east_wall_1">
        <pose>3 -1 0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2 2.5</size>
            </box>
